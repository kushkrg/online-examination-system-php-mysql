# Uploaded files are data, never code: block script execution in this folder (Apache).
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
Options -ExecCGI

# Only applies where PHP runs as an Apache module; ignored on PHP-FPM hosts.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
